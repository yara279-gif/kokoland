    {
      "name": "Book Management",
      "item": [
        {
          "name": "POST /books/customize/ - Customize Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "book",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "child_name",
                  "value": "Alice",
                  "type": "text"
                },
                {
                  "key": "child_age",
                  "value": "5",
                  "type": "text"
                },
                {
                  "key": "child_image",
                  "src": [],
                  "type": "file"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/books/customize/",
              "host": ["{{base_url}}"],
              "path": ["books", "customize", ""]
            }
          },
          "response": [
            {
              "name": "Success Response",
              "status": "Created",
              "code": 201,
              "body": "{\n    \"success\": true,\n    \"message\": \"Book customized successfully!\",\n    \"customization_id\": 1,\n    \"book_id\": 1,\n    \"book_title\": \"Sample Book\",\n    \"child_name\": \"Alice\",\n    \"images_processed\": 5,\n    \"total_images\": 5,\n    \"character_replacements\": 3,\n    \"character_replaced\": true,\n    \"original_character_name\": \"Tommy\",\n    \"custom_book_url\": \"http://localhost:8000/books/customizations/1/file/\",\n    \"child_image_url\": \"http://localhost:8000/books/customizations/1/child-image/\",\n    \"ai_processing_used\": true,\n    \"created_at\": \"2024-01-15T10:30:00Z\"\n}"
